# MSan mix-in profile for Memory Sanitizer builds with clang-20 runtime
# IMPORTANT: MSan requires libc++ instead of libstdc++, and all code must be instrumented
#
# Prerequisites:
#   1. Install: sudo dnf install datalogics-msan-runtime-20
#      (or set MSAN_RUNTIME_DIR to a custom location)
#   2. Rebuild ALL dependencies with this profile (--build=*)
#
# Usage:
#   conan install . -pr clang-20-linux-x86_64-msan-cppstd-17 --build=*

{% set MSAN_RUNTIME_DIR = os.getenv("MSAN_RUNTIME_DIR", "/opt/datalogics/msan-runtime-20") %}

[settings]
# Override libstdc++ from base profile - MSan requires libc++
compiler.libcxx=libc++

[buildenv]
MSAN_RUNTIME_DIR={{MSAN_RUNTIME_DIR}}

[runenv]
LD_LIBRARY_PATH={{MSAN_RUNTIME_DIR}}/lib

[conf]
# MSan compile flags with origin tracking for better error messages
tools.build:cflags+=["-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-fno-omit-frame-pointer"]
tools.build:cxxflags+=["-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-fno-omit-frame-pointer", "-stdlib=libc++", "-nostdinc++", "-isystem", "{{MSAN_RUNTIME_DIR}}/include/c++/v1"]
tools.build:sharedlinkflags+=["-fsanitize=memory", "-stdlib=libc++", "-L{{MSAN_RUNTIME_DIR}}/lib", "-Wl,-rpath,{{MSAN_RUNTIME_DIR}}/lib", "-lc++abi"]
tools.build:exelinkflags+=["-fsanitize=memory", "-stdlib=libc++", "-L{{MSAN_RUNTIME_DIR}}/lib", "-Wl,-rpath,{{MSAN_RUNTIME_DIR}}/lib", "-lc++abi"]
tools.gnu:extra_configure_args+=["ac_cv_tls=__thread"]
