# MSan mix-in profile for Memory Sanitizer builds
# IMPORTANT: MSan requires libc++ instead of libstdc++, and all code must be instrumented
#
# Prerequisites:
#   1. Set MSAN_RUNTIME_DIR environment variable to the MSan-instrumented libc++ path
#      Example: export MSAN_RUNTIME_DIR=/devlocal/robb/pdfl18_all/msan-runtime/install
#   2. Rebuild ALL dependencies with this profile (--build=*)
#
# Usage:
#   source /devlocal/robb/pdfl18_all/msan-runtime/msan-build-env.sh
#   conan install . -pr clang-18-linux-x86_64-msan-cppstd-17 --build=*

[settings]
# Override libstdc++ from base profile - MSan requires libc++
compiler.libcxx=libc++

[conf]
# MSan compile flags with origin tracking for better error messages
tools.build:cflags+=["-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-fno-omit-frame-pointer"]
tools.build:cxxflags+=["-fsanitize=memory", "-fsanitize-memory-track-origins=2", "-fno-omit-frame-pointer", "-stdlib=libc++", "-nostdinc++", "-isystem", "{{os.getenv('MSAN_RUNTIME_DIR', '/devlocal/robb/pdfl18_all/msan-runtime/install')}}/include/c++/v1"]
tools.build:sharedlinkflags+=["-fsanitize=memory", "-stdlib=libc++", "-L{{os.getenv('MSAN_RUNTIME_DIR', '/devlocal/robb/pdfl18_all/msan-runtime/install')}}/lib", "-Wl,-rpath,{{os.getenv('MSAN_RUNTIME_DIR', '/devlocal/robb/pdfl18_all/msan-runtime/install')}}/lib"]
tools.build:exelinkflags+=["-fsanitize=memory", "-stdlib=libc++", "-L{{os.getenv('MSAN_RUNTIME_DIR', '/devlocal/robb/pdfl18_all/msan-runtime/install')}}/lib", "-Wl,-rpath,{{os.getenv('MSAN_RUNTIME_DIR', '/devlocal/robb/pdfl18_all/msan-runtime/install')}}/lib"]
